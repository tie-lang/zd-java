<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.tielang</groupId>
    <artifactId>zd-java</artifactId>
    <version>0.2.0</version>
    <packaging>jar</packaging>

    <name>zd-java</name>
    <description>zd (tie ecosystem binary serialization) codec — pure JDK, no dependencies / zd（tie 生态二进制序列化格式）编解码库 — 纯 JDK、零依赖</description>
    <url>https://github.com/tie-lang/zd-java</url>

    <license>
        <name>Tie Public License 2.2</name>
        <url>https://github.com/tie-lang/zd-java/blob/main/LICENSE</url>
        <distribution>repo</distribution>
    </license>

    <organization>
        <name>TIE-LANG organization</name>
        <url>https://github.com/tie-lang</url>
    </organization>

    <developers>
        <developer>
            <name>tie-lang</name>
            <organization>TIE-LANG organization</organization>
            <organizationUrl>https://github.com/tie-lang</organizationUrl>
        </developer>
    </developers>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 发布目标（Sonatype Central Portal）。实际部署走 release profile（见下），
         日常 `mvn package` 不受影响。 / Publishing targets (Sonatype Central Portal).
         Deployment rides the release profile below; plain `mvn package` is unaffected. -->
    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

    <profiles>
        <!-- `mvn -Prelease deploy`：源码/文档 jar + GPG 签名 + Central Portal 上传。
             凭据在 ~/.m2/settings.xml（server id = central），GPG 私钥须已导入。
             / `mvn -Prelease deploy`: source/javadoc jars + GPG signing + Central
             Portal upload. Credentials live in ~/.m2/settings.xml (server id
             `central`); the GPG private key must be imported. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <doclint>none</doclint>
                                    <encoding>UTF-8</encoding>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
